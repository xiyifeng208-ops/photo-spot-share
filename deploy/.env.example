# 复制为 deploy/.env 后填写；docker compose 会读取它
NODE_ENV=production
POSTGRES_USER=spot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=spot

PUBLIC_BASE_URL=https://api.example.com
DATABASE_URL=postgres://spot:change-me-strong-password@postgres:5432/spot

JWT_SECRET=please-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=30d
# 生产必须为 false
AUTH_DEV_MODE=false

WX_APPID=
WX_SECRET=
AMAP_KEY=

# 生产建议使用 cos；先用 local 跑通也没问题
STORAGE_DRIVER=cos
CDN_BASE_URL=https://cdn.example.com
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1300000000
COS_REGION=ap-shanghai
COS_UPLOAD_PREFIX=uploads

RATE_LIMIT_GEO_PER_MINUTE=30
RATE_LIMIT_SPOT_PER_DAY=20
CONTENT_CHECK_ENABLED=false

