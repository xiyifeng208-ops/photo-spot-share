<view class="page">
  <view class="filters">
    <view class="chip {{city ? 'chip--active' : ''}}" bindtap="onToggleCity">
      {{city ? city : '全部城市'}}
    </view>
    <view class="filters__hint muted">{{city ? '仅看当前城市' : '按城市筛选可点这里'}}</view>
  </view>

  <view class="card spot" wx:for="{{spots}}" wx:key="id" data-id="{{item.id}}" bindtap="onSpotTap">
    <image class="spot__cover" src="{{item.coverUrl}}" mode="aspectFill" wx:if="{{item.coverUrl}}"></image>
    <view class="spot__cover spot__cover--empty" wx:else>暂无照片</view>
    <view class="spot__body">
      <view class="spot__title">{{item.title}}</view>
      <view class="spot__meta">
        <text>{{item.city || '未知城市'}}</text>
        <text wx:if="{{item.distanceText}}" class="spot__distance">{{item.distanceText}}</text>
      </view>
      <view class="spot__tags">
        <text class="tag tag--soft" wx:for="{{item.tagList}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="spot__footer muted">{{item.author.nickname || '匿名摄影师'}} · {{item.createdText}}</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!spots.length && !loading}}">
    <view>{{city ? city + ' 还没有人分享机位' : '还没有任何机位'}}</view>
    <view class="btn-primary empty__btn" bindtap="onCreateTap">创建第一个机位</view>
  </view>

  <view class="footer muted" wx:if="{{spots.length}}">{{finished ? '没有更多了' : '上拉加载更多'}}</view>
</view>

