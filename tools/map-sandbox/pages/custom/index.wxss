.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 96rpx 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  z-index: 10;
}

.topbar__title {
  font-size: 32rpx;
  font-weight: 600;
}

.topbar__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #12a594;
}

