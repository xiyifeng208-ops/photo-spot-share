.drafts-entry { display: flex; align-items: center; justify-content: space-between; color: #0a8a7d; font-size: 28rpx; padding: 24rpx; margin-bottom: 20rpx; }
.drafts-entry__hint { font-size: 22rpx; color: #6b7280; margin-left: 16rpx; }
.profile {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eef7f6;
  color: #0d8578;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile__name {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile__action {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef7f6;
  color: #0d8578;
  font-size: 26rpx;
}

.spot {
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.spot__main {
  display: flex;
}

.spot__cover {
  width: 180rpx;
  height: 135rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
  overflow: hidden;
}

.spot__cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.spot__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.spot__body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.spot__title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot__meta {
  margin-top: 8rpx;
}

.spot__status {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #b45309;
  font-size: 22rpx;
}

.spot__tags {
  margin-top: 12rpx;
}

.spot__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  border-top: 2rpx solid #f3f4f6;
  padding-top: 20rpx;
}

.spot__btn {
  padding: 10rpx 28rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 26rpx;
}

.spot__btn--danger {
  background: #fdecec;
  color: #e5484d;
}

.empty__hint {
  margin-top: 12rpx;
}

.empty__btn {
  margin-top: 40rpx;
}

.legal {
  padding: 48rpx 0 40rpx;
  text-align: center;
}

.legal__link {
  font-size: 26rpx;
  color: #6b7280;
  text-decoration: underline;
}

.legal__sep {
  margin: 0 16rpx;
  color: #d1d5db;
}

.tabs { display: flex; margin-bottom: 24rpx; background: #fff; border-radius: 20rpx; padding: 8rpx; }
.tabs__item { flex: 1; text-align: center; padding: 20rpx 12rpx; color: #6b7280; font-size: 28rpx; border-radius: 16rpx; }
.tabs__item--active { background: #eef7f6; color: #0d8578; font-weight: 600; }
.filters { position: relative; display: flex; align-items: center; margin-bottom: 20rpx; height: 64rpx; }
.filters--open { z-index: 101; }
.filters__city { display: flex; align-items: center; max-width: 320rpx; box-sizing: border-box; padding: 14rpx 24rpx; border-radius: 999rpx; background: #12a594; color: #fff; font-size: 28rpx; }
.filters__name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filters__arrow { flex-shrink: 0; margin-left: 12rpx; }
.filters__hint { margin-left: 20rpx; font-size: 24rpx; color: #6b7280; }
.city-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(31,36,48,0.15); z-index: 100; }
.city-picker { position: absolute; left: 0; right: 0; top: 80rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 12rpx 40rpx rgba(31,36,48,0.16); overflow: hidden; }
.city-picker__all { padding: 24rpx; border-bottom: 2rpx solid #f3f4f6; font-size: 28rpx; }
.city-picker__columns { display: flex; height: 50vh; max-height: 600rpx; }
.city-picker__provinces { width: 40%; height: 100%; background: #f5f6f8; }
.city-picker__cities { flex: 1; width: 60%; height: 100%; }
.city-picker__item { padding: 24rpx 20rpx; font-size: 26rpx; line-height: 1.5; word-break: break-all; }
.city-picker__selected { color: #0d8578; background: #eef7f6; font-weight: 600; }
.city-picker__province--active { color: #0d8578; background: #fff; font-weight: 600; }
.spot__btn--favorite { color: #0d8578; background: #eef7f6; }
.spot__btn--disabled { opacity: 0.5; }
.list-footer { text-align: center; padding: 24rpx; }
.list-error { text-align: center; padding: 40rpx 24rpx; color: #4b5563; }
.list-error__message { margin-top: 12rpx; word-break: break-all; }
.list-error__retry { display: inline-block; padding: 16rpx 40rpx; margin-top: 20rpx; border-radius: 999rpx; background: #eef7f6; color: #0d8578; }
.spot__favorite-count { margin-top: 10rpx; color: #0d8578; font-size: 23rpx; }
