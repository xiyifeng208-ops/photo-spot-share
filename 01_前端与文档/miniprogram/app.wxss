page {
  --primary: #12a594;
  --primary-dark: #0d8578;
  --accent: #ff7a45;
  --text: #1f2430;
  --text-sub: #6b7280;
  --line: #eceef2;
  --bg: #f5f6f8;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 36, 48, 0.06);
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: #eef7f6;
  color: var(--primary-dark);
  font-size: 22rpx;
}

.tag--soft {
  background: #f3f4f6;
  color: var(--text-sub);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
}

.btn-primary--ghost {
  background: #fff;
  color: var(--primary-dark);
  border: 2rpx solid var(--primary);
}

.btn-primary[disabled] {
  background: #cfd6dd;
  color: #fff;
}

.muted {
  color: var(--text-sub);
  font-size: 24rpx;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--text-sub);
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 165, 148, 0.35);
  z-index: 20;
}

