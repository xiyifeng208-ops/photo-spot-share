<view class="detail" wx:if="{{spot}}">
  <swiper class="gallery" indicator-dots="{{photos.length > 1}}" circular="{{photos.length > 1}}" wx:if="{{photos.length}}">
    <swiper-item wx:for="{{photos}}" wx:key="key">
      <image
        class="gallery__image"
        src="{{item.url}}"
        mode="aspectFill"
        data-url="{{item.url}}"
        bindtap="onPreviewPhoto"
      ></image>
    </swiper-item>
  </swiper>
  <view class="gallery gallery--empty" wx:else>这个机位还没有样张</view>

  <view class="body">
    <view class="card">
      <view class="title">{{spot.title}}</view>
      <view class="meta">
        <text>{{spot.author.nickname || '匿名摄影师'}}</text>
        <text class="meta__dot">·</text>
        <text>{{createdText}}</text>
        <text wx:if="{{distanceText}}" class="meta__distance">距你 {{distanceText}}</text>
      </view>
      <view class="address">{{spot.province || ''}}{{spot.city || ''}}{{spot.district || ''}} {{spot.address || ''}}</view>
      <view class="favorite-count">☆ {{spot.favoriteCount}} 人收藏</view>
    </view>

    <view class="card">
      <view class="section-title">拍摄参数</view>
      <view class="params">
        <view class="param" wx:for="{{params}}" wx:key="label">
          <view class="param__label">{{item.label}}</view>
          <view class="param__value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="card tools-card">
      <view class="tools-heading"><view class="section-title">拍摄时间助手</view><text class="tools-badge">北京时间</text></view>
      <view class="tools-note">理论参考，非天气预报；实际效果受天气、建筑遮挡与开放情况影响。</view>
      <view wx:if="{{spot.status !== 'active'}}" class="tools-empty">仅公开机位可使用拍摄时间助手。</view>
      <block wx:else>
        <picker mode="date" value="{{shootingDate}}" start="2000-01-01" end="2100-12-31" bindchange="onShootingDateChange">
          <view class="time-date"><text>拍摄日期</text><text class="time-date__value">{{shootingDate}} ▾</text></view>
        </picker>
        <view class="tools-empty" wx:if="{{shootingLoading}}">正在计算参考时段…</view>
        <view class="tools-error" wx:elif="{{shootingError}}"><text>{{shootingError}}</text><text class="tools-link" bindtap="onShootingRetry">重试</text></view>
        <block wx:elif="{{shootingLoaded}}">
          <view class="time-row" wx:for="{{shootingRows}}" wx:key="key">
            <text class="time-row__label">{{item.label}}</text><text class="time-row__value {{!item.available ? 'time-row__value--empty' : ''}}">{{item.text}}</text>
          </view>
          <view class="time-notes" wx:for="{{shootingNotes}}" wx:key="*this">{{item}}</view>
        </block>
      </block>
    </view>

    <view class="card tools-card">
      <view class="tools-heading"><view class="section-title">近期反馈</view><text class="tools-badge">近 30 天</text></view>
      <view class="tools-note">用户反馈未经核实，仅供出行前参考，不代表安全或开放承诺。</view>
      <view wx:if="{{spot.status !== 'active'}}" class="tools-empty">仅公开机位可查看和提交现场反馈。</view>
      <block wx:else>
        <view class="feedback-row" wx:for="{{feedbackItems}}" wx:key="id">
          <view><text class="feedback-row__kind">{{item.label}}</text><text wx:if="{{item.isMine}}" class="feedback-row__mine">我的</text></view>
          <view class="feedback-row__meta">更新于 {{item.updatedText}} · 用户反馈未经核实</view>
        </view>
        <view class="tools-empty" wx:if="{{feedbackLoading}}">正在加载近期反馈…</view>
        <view class="tools-error" wx:if="{{feedbackError}}"><text>{{feedbackError}}</text><text class="tools-link" bindtap="onFeedbackRetry">重试</text></view>
        <view class="tools-empty" wx:if="{{feedbackLoaded && !feedbackLoading && !feedbackError && !feedbackItems.length}}">暂无近 30 天反馈，到现场后可补充。</view>
        <view class="feedback-more" wx:if="{{feedbackMoreLoading}}">正在加载更多…</view>
        <view class="feedback-more tools-link" wx:elif="{{feedbackCursor && !feedbackLoading && !feedbackError}}" bindtap="onFeedbackMore">查看更多近期反馈</view>

        <view class="feedback-form">
          <view class="feedback-form__title">我在现场看到的情况</view>
          <view class="tools-note">每个账号保留一条最新反馈，可更新或撤回。提交时需登录；更新时间不代表实际到访时间。</view>
          <view class="feedback-current" wx:if="{{feedbackNotice}}">{{feedbackNotice}}</view>
          <view class="feedback-options {{feedbackPending ? 'tools-disabled' : ''}}">
            <view class="feedback-option {{feedbackKind === item.kind ? 'feedback-option--selected' : ''}}" wx:for="{{feedbackOptions}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="onChooseFeedback">{{item.label}}</view>
          </view>
          <view class="feedback-current" wx:if="{{myFeedback}}">我的近期反馈：{{myFeedback.label}}（未经核实）</view>
          <view class="tools-error" wx:if="{{feedbackActionError}}"><text>{{feedbackActionError}}</text><text class="tools-link" bindtap="onFeedbackActionRetry">重试操作</text></view>
          <view class="feedback-actions {{feedbackPending ? 'tools-disabled' : ''}}">
            <view class="feedback-submit" bindtap="onSubmitFeedback">{{feedbackPending ? '处理中…' : (myFeedback ? '更新我的反馈' : '提交现场反馈')}}</view>
            <view class="feedback-withdraw" wx:if="{{myFeedback}}" bindtap="onWithdrawFeedback">撤回反馈</view>
          </view>
        </view>
      </block>
    </view>

    <view class="card" wx:if="{{spot.description}}">
      <view class="section-title">怎么拍</view>
      <view class="description">{{spot.description}}</view>
    </view>

    <view class="card" wx:if="{{spot.accessNote}}">
      <view class="section-title">怎么到</view>
      <view class="description">{{spot.accessNote}}</view>
    </view>

    <view class="card card--map">
      <map
        class="mini-map"
        latitude="{{spot.lat}}"
        longitude="{{spot.lng}}"
        scale="16"
        markers="{{marker}}"
        bindtap="onMapTap"
      ></map>
      <view class="mini-map__hint muted">点击地图可打开导航</view>
    </view>

    <view class="coords muted" bindtap="onCopyCoordinate">
      坐标 {{spot.lat}}, {{spot.lng}} · 点击复制
    </view>

    <view class="danger" wx:if="{{spot.isMine}}">
      <view class="danger__btn" bindtap="onEditTap">编辑机位</view>
      <view class="danger__btn danger__btn--danger" bindtap="onDeleteTap">删除机位</view>
    </view>

    <view class="report muted" wx:if="{{!spot.isMine}}" bindtap="onReportTap">举报该机位</view>
  </view>

  <view class="actionbar">
    <view
      class="actionbar__favorite {{favoriteStateReady && spot.isFavorited ? 'actionbar__favorite--active' : ''}} {{favoritePending || loading || (favoriteStateReady && !spot.isFavorited && spot.status !== 'active') ? 'actionbar__favorite--disabled' : ''}}"
      bindtap="onFavoriteTap"
    >{{favoritePending || loading ? '处理中…' : (!favoriteStateReady ? '重试收藏' : (spot.isFavorited ? '★ 已收藏' : '☆ 收藏'))}}</view>
    <view class="actionbar__ghost" bindtap="onCopyCoordinate">复制坐标</view>
    <view class="actionbar__primary" bindtap="onNavigateTap">导航到这里</view>
  </view>
</view>

<view class="empty" wx:elif="{{loading}}">加载中…</view>
<view class="empty" wx:else>机位不存在或已被删除</view>
