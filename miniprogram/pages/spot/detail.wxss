.detail {
  padding-bottom: 180rpx;
}

.gallery {
  width: 100%;
  height: 560rpx;
  background: #eceef2;
}

.gallery--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  height: 320rpx;
}

.gallery__image {
  width: 100%;
  height: 100%;
}

.body {
  padding: 24rpx;
}

.card {
  margin-bottom: 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.meta__dot {
  margin: 0 8rpx;
}

.meta__distance {
  margin-left: 16rpx;
  color: #12a594;
}

.address {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.params {
  display: flex;
  flex-wrap: wrap;
}

.param {
  width: 50%;
  margin-bottom: 16rpx;
}

.param__label {
  font-size: 22rpx;
  color: #9ca3af;
}

.param__value {
  margin-top: 4rpx;
  font-size: 28rpx;
}

.description {
  font-size: 28rpx;
  line-height: 46rpx;
  color: #374151;
  white-space: pre-wrap;
}

.card--map {
  padding: 0;
  overflow: hidden;
}

.mini-map {
  width: 100%;
  height: 320rpx;
}

.mini-map__hint {
  padding: 16rpx 24rpx;
}

.coords {
  padding: 8rpx 8rpx 24rpx;
}

.danger {
  display: flex;
}

.danger__btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: #4b5563;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.danger__btn--danger {
  background: #fdecec;
  color: #e5484d;
  margin-right: 0;
}

.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(31, 36, 48, 0.08);
}

.actionbar__ghost {
  width: 220rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.actionbar__primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #12a594;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}

