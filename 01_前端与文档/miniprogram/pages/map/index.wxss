.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 96rpx 32rpx 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.75));
  z-index: 10;
}

.topbar__title {
  font-size: 36rpx;
  font-weight: 600;
}

.topbar__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.topbar__debug {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9ca3af;
  word-break: break-all;
}

.locate-btn {
  position: fixed;
  right: 32rpx;
  bottom: 300rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 36, 48, 0.12);
  z-index: 20;
}

.locate-btn__icon {
  margin-right: 8rpx;
  color: #12a594;
}

.fab {
  bottom: 160rpx;
  width: auto;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.fallback {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 30%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 36, 48, 0.18);
  z-index: 25;
}

.fallback__title {
  font-size: 32rpx;
  font-weight: 600;
}

.fallback__desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #6b7280;
}

.fallback__actions {
  display: flex;
  margin-top: 28rpx;
}

.fallback__btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.fallback__btn:last-child {
  margin-right: 0;
}

.fallback__btn--primary {
  background: #12a594;
  color: #fff;
}

.card {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 36, 48, 0.18);
  z-index: 30;
}

.card__row {
  display: flex;
}

.card__cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
  overflow: hidden;
}

.card__cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.card__body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.card__distance {
  margin-left: 16rpx;
  color: #12a594;
}

.card__tags {
  margin-top: 12rpx;
}

.card__actions {
  display: flex;
  margin-top: 24rpx;
}

.card__action {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.card__action--ghost {
  background: #f3f4f6;
  color: #4b5563;
  margin-right: 20rpx;
}

.card__action--primary {
  background: #12a594;
  color: #fff;
}
