.page {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.block {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.map {
  width: 100%;
  height: 320rpx;
  background: #f5f6f8;
}

.status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #12a594;
}

.status--mono {
  color: #374151;
  word-break: break-all;
}

