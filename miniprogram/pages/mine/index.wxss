.profile {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eef7f6;
  color: #0d8578;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile__body {
  flex: 1;
  margin-left: 20rpx;
}

.profile__name {
  font-size: 32rpx;
  font-weight: 600;
}

.profile__action {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eef7f6;
  color: #0d8578;
  font-size: 26rpx;
}

.spot {
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.spot__main {
  display: flex;
}

.spot__cover {
  width: 180rpx;
  height: 135rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.spot__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.spot__body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.spot__title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot__meta {
  margin-top: 8rpx;
}

.spot__tags {
  margin-top: 12rpx;
}

.spot__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  border-top: 2rpx solid #f3f4f6;
  padding-top: 20rpx;
}

.spot__btn {
  padding: 10rpx 28rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 26rpx;
}

.spot__btn--danger {
  background: #fdecec;
  color: #e5484d;
}

.empty__hint {
  margin-top: 12rpx;
}

.empty__btn {
  margin-top: 40rpx;
}

