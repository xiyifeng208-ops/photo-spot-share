.picker {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.picker__map {
  width: 100%;
  height: 100%;
}

.picker__pin {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 116rpx;
  margin-left: -44rpx;
  margin-top: -116rpx;
}

.picker__pin-icon {
  width: 88rpx;
  height: 116rpx;
}

.picker__panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 36, 48, 0.18);
}

.picker__tip {
  font-size: 24rpx;
}

.picker__address {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 46rpx;
}

.picker__hint {
  margin-top: 8rpx;
}

.picker__actions {
  display: flex;
  margin-top: 28rpx;
}

.picker__locate {
  width: 240rpx;
  margin-right: 20rpx;
}

.picker__next {
  flex: 1;
}

.form {
  padding: 24rpx 24rpx 200rpx;
}

.card {
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field__label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.field__label--gap {
  margin-top: 28rpx;
}

.field__input {
  height: 84rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.field__input--address {
  margin-top: 12rpx;
  font-size: 28rpx;
}

.field__hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

.field__textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.field__textarea--short {
  min-height: 140rpx;
}

.field__static {
  font-size: 28rpx;
  line-height: 42rpx;
}

.field__link {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #12a594;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.photo {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.photo__img {
  width: 100%;
  height: 100%;
}

.photo__remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  border-bottom-left-radius: 16rpx;
  font-size: 32rpx;
}

.photo--add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #9ca3af;
  border: 2rpx dashed #d1d5db;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 26rpx;
}

.chip--active {
  background: #12a594;
  color: #fff;
}

.form__actions {
  margin-top: 40rpx;
}

.agree {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.agree__box {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}

.agree__box--on {
  background: #12a594;
  border-color: #12a594;
}

.agree__text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.agree__link {
  color: #12a594;
}

.form__tip {
  margin-top: 20rpx;
  text-align: center;
}
