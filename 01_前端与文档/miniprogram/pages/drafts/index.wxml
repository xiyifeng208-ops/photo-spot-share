<view class="page">
  <view class="notice">每个账号最多 10 份草稿，本机草稿图片合计不超过 100 MB。草稿不跨设备同步，清除小程序数据会丢失草稿。</view>
  <view class="new-draft" bindtap="onNew">＋ 新建机位</view>
  <view class="card draft" wx:for="{{items}}" wx:key="id">
    <view class="draft__main" data-id="{{item.id}}" bindtap="onResume">
      <image wx:if="{{item.cover}}" class="draft__cover" src="{{item.cover}}" mode="aspectFill" data-id="{{item.id}}" binderror="onCoverError"></image>
      <view wx:else class="draft__cover draft__cover--empty">暂无照片</view>
      <view class="draft__body">
        <view class="draft__title">{{item.title}}</view>
        <view class="muted">{{item.region}} · {{item.photoCount}} 张照片</view>
        <view class="muted draft__time">保存于 {{item.updatedText}}</view>
      </view>
    </view>
    <view class="draft__actions"><text data-id="{{item.id}}" bindtap="onResume">继续编辑</text><text class="draft__delete" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onDelete">{{deletingId === item.id ? '删除中…' : '删除草稿'}}</text></view>
  </view>
  <view class="state muted" wx:if="{{loading}}">正在读取本机草稿…</view>
  <view class="state" wx:elif="{{error}}"><view>{{error}}</view><view class="retry" bindtap="reload">重试</view></view>
  <view class="state muted" wx:elif="{{!items.length}}">还没有发布草稿，填写新机位后会自动保存。</view>
</view>
