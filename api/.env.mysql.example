# Reference only. Do not replace the current PostgreSQL .env during migration rehearsal.
# URL-encode special characters in the username/password.
DATABASE_URL=mysql://APP_USER:URL_ENCODED_PASSWORD@MYSQL_HOST:3306/photo_spot_share
DATABASE_SSL=true
# Development-only opt-in; never automatically falls back from TLS.
DATABASE_ALLOW_INSECURE_REMOTE=false
# PEM CA certificate supplied through a trusted channel by the database provider.
# Leave blank only when the certificate is trusted by the Node.js trust store.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
