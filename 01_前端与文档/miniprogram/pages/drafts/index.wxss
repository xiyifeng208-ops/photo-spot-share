.page { padding: 24rpx; }
.notice { padding: 24rpx; background: #e8f6f2; border-radius: 20rpx; color: #526660; font-size: 24rpx; line-height: 38rpx; }
.new-draft { margin: 24rpx 0; text-align: center; color: #12a594; font-size: 28rpx; padding: 22rpx; border: 2rpx solid #12a594; border-radius: 18rpx; }
.draft { padding: 24rpx; margin-bottom: 20rpx; }
.draft__main { display: flex; gap: 20rpx; align-items: center; }
.draft__cover { width: 150rpx; height: 130rpx; flex-shrink: 0; border-radius: 16rpx; background: #f3f4f6; }
.draft__cover--empty { display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #9ca3af; }
.draft__body { min-width: 0; flex: 1; font-size: 24rpx; }
.draft__title { font-size: 30rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; margin-bottom: 12rpx; }
.draft__time { margin-top: 8rpx; }
.draft__actions { display: flex; justify-content: flex-end; gap: 32rpx; margin-top: 24rpx; font-size: 26rpx; color: #12a594; }
.draft__delete { color: #d54c50; }
.state { margin: 60rpx 0; text-align: center; font-size: 26rpx; line-height: 42rpx; }
.retry { color: #12a594; margin-top: 20rpx; }
