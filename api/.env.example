# ---------- 基础 ----------
NODE_ENV=development
PORT=3000
# 单机部署时用于拼接本地存储的图片访问地址（本地驱动才会用到）
PUBLIC_BASE_URL=http://localhost:3000

# ---------- 数据库 ----------
DATABASE_URL=postgres://spot:spot@localhost:5432/spot
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---------- 鉴权 ----------
# 生产环境务必替换为随机长字符串
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# 本地开发没有小程序 AppID 时置 true：允许前端用 dev:<设备ID> 登录
AUTH_DEV_MODE=true

# ---------- 微信小程序 ----------
WX_APPID=
WX_SECRET=

# ---------- 高德 Web 服务 ----------
# 类型必须是「Web服务」的 Key，只在服务端使用
AMAP_KEY=

# ---------- 图片存储 ----------
# local | cos
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=var/uploads
# 小程序直传用的 CDN/加速域名，留空时回退到 PUBLIC_BASE_URL/static
CDN_BASE_URL=

# STORAGE_DRIVER=cos 时必填
# 建议使用 RAM 子账号，权限仅限该存储桶的 uploads/ 前缀
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_UPLOAD_PREFIX=uploads

# ---------- 限流 ----------
RATE_LIMIT_GEO_PER_MINUTE=30
RATE_LIMIT_SPOT_PER_DAY=20

# ---------- 预留：内容安全审核（v1 关闭） ----------
CONTENT_CHECK_ENABLED=false

