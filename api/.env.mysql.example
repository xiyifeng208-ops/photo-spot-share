# Copy to .env.mysql.local (git-ignored). Never commit real passwords.
# Percent-encode special characters in URL usernames/passwords.
SOURCE_DATABASE_URL=postgres://spot:spot@localhost:5432/spot
TARGET_DATABASE_URL=mysql://YOUR_USER:YOUR_PASSWORD@mysql6.sqlpub.com:3311/photo_spot_share
# Confirm TLS availability with the provider before setting this value.
TARGET_DATABASE_SSL=false
# After migration, set DATABASE_URL in the existing api/.env to TARGET_DATABASE_URL.
# Keep JWT_SECRET and local storage settings unchanged.
# Recommended runtime pool for the 10-connection online instance:
# DATABASE_POOL_MAX=3
