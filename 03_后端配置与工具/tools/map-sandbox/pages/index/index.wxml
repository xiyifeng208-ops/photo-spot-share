<scroll-view scroll-y class="page">
  <view class="tip">四格都是地图。看每格下面的状态文字：出现 “updated 已触发” = 组件能初始化。</view>

  <view class="block">
    <view class="label">① 最简写法：只有 lat / lng / scale</view>
    <map
      id="map1"
      class="map"
      latitude="31.2397"
      longitude="121.4903"
      scale="14"
      data-key="status1"
      bindupdated="onUpdated"
      binderror="onError"
      bindregionchange="onRegionChange"
    ></map>
    <view class="status">{{status1}}</view>
  </view>

  <view class="block">
    <view class="label">② 带 markers 与 show-location</view>
    <map
      class="map"
      latitude="31.2397"
      longitude="121.4903"
      scale="14"
      markers="{{markers}}"
      show-location="{{true}}"
      data-key="status2"
      bindupdated="onUpdated"
      binderror="onError"
    ></map>
    <view class="status">{{status2}}</view>
  </view>

  <view class="block">
    <view class="label">③ 用行内 style 指定尺寸（不走 wxss 类）</view>
    <map
      latitude="31.2397"
      longitude="121.4903"
      scale="14"
      style="width: 100%; height: 320rpx;"
      data-key="status3"
      bindupdated="onUpdated"
      binderror="onError"
    ></map>
    <view class="status">{{status3}}</view>
  </view>

  <view class="block">
    <view class="label">getRegion 回调测试（业务页面依赖它）</view>
    <view class="status status--mono">{{regionLog}}</view>
    <button size="mini" bindtap="onGetRegion">调用 getRegion</button>
  </view>
</scroll-view>

